void functionDemo()
{
    int x = 10;
    byValue(x);
    cout << "\nCall by value: " << x;
    byAddress(&x);
    cout << "\nCall by address: " << x;
    byReference(x);
    cout << "\nCall by reference: " << x;
    cout << "\nFunction overloading:\n";
    show(100);
    show("Blood Pressure");
}
